<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Status - <%= repair.ticketId %>
  </title>
</head>

<body
  style="background-color: #0f172a; font-family: 'Segoe UI', Roboto, Helvetica, sans-serif; color: #f8fafc; padding: 60px 20px; min-height: 100vh; margin: 0; box-sizing: border-box; display: flex; justify-content: center; align-items: center;">

  <div
    style="max-width: 650px; width: 100%; background: #1e293b; border: 1px solid #334155; padding: 40px; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);">

    <!-- Header Section -->
    <div
      style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; padding-bottom: 24px; margin-bottom: 30px;">
      <div>
        <h2 style="margin: 0; color: #ea580c; font-size: 24px; font-weight: 800; letter-spacing: -0.5px;">ASO COMMS</h2>
        <span style="font-size: 13px; color: #94a3b8; font-weight: 500;">Real-time Pipeline Tracking Verification</span>
      </div>
      <div
        style="background: #0f172a; padding: 10px 16px; border-radius: 8px; font-family: monospace; font-weight: bold; font-size: 15px; border: 1px solid #475569; color: #38bdf8;">
        <%= repair.ticketId %>
      </div>
    </div>

    <!-- Status Highlight Banner -->
    <div
      style="background-color: #ea580c15; border-left: 4px solid #ea580c; padding: 20px; margin-bottom: 35px; border-radius: 0 12px 12px 0; border: 1px solid #ea580c33; border-left: 4px solid #ea580c;">
      <span
        style="font-size: 11px; color: #ea580c; font-weight: 800; text-transform: uppercase; display: block; margin-bottom: 6px; letter-spacing: 0.5px;">
        Current Operational Status
      </span>
      <h3 style="margin: 0; color: #f8fafc; font-size: 26px; font-weight: 700;">
        <%= repair.status==='Ready' ? '✅ ' : '' %>
          <%= repair.status==='Repairing' ? '🛠️ ' : '' %>
            <%= repair.status || 'Pending Verification' %>
      </h3>
    </div>

    <!-- Info Cards Grid -->
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; border-bottom: 1px solid #334155; padding-bottom: 30px; margin-bottom: 30px;">

      <!-- Left Card: Customer Info -->
      <div style="background: #0f172a; padding: 20px; border-radius: 12px; border: 1px solid #334155;">
        <h4
          style="margin: 0 0 16px 0; color: #64748b; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800;">
          Customer Reference
        </h4>
        <div style="font-size: 14px; line-height: 1.7; color: #cbd5e1;">
          <p style="margin: 6px 0;">
            <span style="color: #64748b;">Client:</span> <strong style="color: #f8fafc;">
              <%= maskedCustomer.name %>
            </strong>
          </p>
          <p style="margin: 6px 0;">
            <span style="color: #64748b;">Phone:</span> <strong style="color: #38bdf8; font-family: monospace;">
              <%= maskedCustomer.phone %>
            </strong>
          </p>
        </div>
      </div>

      <!-- Right Card: Hardware Info -->
      <div style="background: #0f172a; padding: 20px; border-radius: 12px; border: 1px solid #334155;">
        <h4
          style="margin: 0 0 16px 0; color: #64748b; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800;">
          Hardware Information
        </h4>
        <div style="font-size: 14px; line-height: 1.7; color: #cbd5e1;">
          <p style="margin: 6px 0;">
            <span style="color: #64748b;">Device:</span> <strong style="color: #f8fafc;">
              <%= repair.deviceModel %>
            </strong>
          </p>
          <p style="margin: 6px 0;">
            <span style="color: #64748b;">Integrity:</span>
            <strong style="color: <%= repair.isDead ? '#ef4444' : '#10b981' %>;">
              <%= repair.isDead ? 'Brought in Dead (DOA)' : 'Powering On' %>
            </strong>
          </p>
          <p
            style="margin: 8px 0 0 0; font-size: 13px; line-height: 1.5; border-top: 1px dashed #334155; padding-top: 8px;">
            <span style="color: #64748b;">Reported Fault:</span><br>
            <span style="color: #94a3b8;">
              <%= repair.issueDescription || "General diagnostics checkup" %>
            </span>
          </p>
        </div>
      </div>

    </div>

    <!-- Financial Card -->
    <h4
      style="margin: 0 0 12px 0; color: #64748b; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800; text-align: left;">
      Financial Statement
    </h4>
    <div
      style="background-color: #0f172a; border: 1px solid #334155; border-radius: 12px; padding: 24px; display: flex; justify-content: space-between; align-items: center; box-shadow: inset 0 2px 4px 0 rgba(0,0,0,0.2);">
      <div style="text-align: left;">
        <span style="font-size: 12px; color: #64748b; display: block; font-weight: 600;">Outstanding Balance Due</span>
        <h3 style="margin: 6px 0 0 0; color: #f8fafc; font-size: 28px; font-weight: 800; letter-spacing: -0.5px;">
          ₦<%= repair.financials.totalEstimate - repair.financials.amountPaid %>
        </h3>
      </div>
      <div style="text-align: right;">
        <span style="font-size: 12px; color: #64748b; display: block; font-weight: 600; margin-bottom: 8px;">Ledger
          State</span>
        <div
          style="background-color: #fef08a15; border: 1px solid #fef08a33; color: #fef08a; font-size: 12px; font-weight: bold; padding: 6px 16px; border-radius: 20px; text-transform: uppercase; display: inline-block; letter-spacing: 0.5px;">
          <%= repair.financials.paymentStatus || 'Pending Sync' %>
        </div>
      </div>
    </div>

    <!-- Action Back Button -->
    <div style="text-align: center; margin-top: 40px;">
      <a href="/track"
        style="background-color: #292524; border: 1px solid #475569; color: #f8fafc; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-size: 14px; font-weight: bold; display: inline-block; transition: all 0.2s; cursor: pointer;"
        onmouseover="this.style.backgroundColor='#1e293b'; this.style.borderColor='#ea580c';"
        onmouseout="this.style.backgroundColor='#292524'; this.style.borderColor='#475569';">
        Check Another Ticket
      </a>
    </div>

  </div>

</body>

</html>