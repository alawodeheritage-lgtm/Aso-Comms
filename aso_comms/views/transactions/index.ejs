<!DOCTYPE html>
<html lang="en">
<head>
    <title>AsoComms Ledger</title>
</head>
<body style="background-color: #fafaf9; font-family: sans-serif; color: #1c1917; padding: 40px;">

    <h1>AsoComms Financial Dashboard</h1>
    
    <div style="display: flex; gap: 20px; margin-bottom: 40px;">
        <div style="background: white; border: 1px solid #e7e5e4; padding: 20px; border-radius: 8px; flex: 1;">
            <h4 style="margin: 0; color: #78716c;">Total Cash-In-Hand (Income)</h4> [cite: 83]
            <p style="font-size: 28px; font-weight: bold; color: #16a34a; margin: 10px 0 0 0;">₦<%= totalIncome %></p> [cite: 83]
        </div>
        <div style="background: white; border: 1px solid #e7e5e4; padding: 20px; border-radius: 8px; flex: 1;">
            <h4 style="margin: 0; color: #78716c;">Total Shop Expenditures</h4>
            <p style="font-size: 28px; font-weight: bold; color: #dc2626; margin: 10px 0 0 0;">₦<%= totalExpenditure %></p>
        </div>
        <div style="background: white; border: 1px solid #e7e5e4; padding: 20px; border-radius: 8px; flex: 1;">
            <h4 style="margin: 0; color: #78716c;">Net Profit</h4>
            <p style="font-size: 28px; font-weight: bold; color: <%= netProfit >= 0 ? '#16a34a' : '#dc2626' %>; margin: 10px 0 0 0;">₦<%= netProfit %></p>
        </div>
    </div>

    <div style="background: white; border: 1px solid #e7e5e4; padding: 25px; border-radius: 8px; margin-bottom: 40px;">
        <h3>Record Shop Expenditure</h3>
        <form action="/transactions/expense" method="POST" style="display: flex; gap: 15px; flex-wrap: wrap;">
            <input type="number" name="amount" placeholder="Amount (₦)" required style="padding: 10px; border: 1px solid #d6d3d1; border-radius: 4px;">
            <input type="text" name="category" placeholder="Category (e.g., Rent, Screens)" required style="padding: 10px; border: 1px solid #d6d3d1; border-radius: 4px;">
            <input type="text" name="description" placeholder="Short Details" style="padding: 10px; border: 1px solid #d6d3d1; border-radius: 4px; flex-grow: 1;">
            <button type="submit" style="background-color: #ea580c; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-weight: bold;">Log Expense</button> [cite: 31]
        </form>
    </div>

    <h3>Transaction History Statement</h3>
    <table style="width: 100%; border-collapse: collapse; background: white; border: 1px solid #e7e5e4; text-align: left;">
        <thead>
            <tr style="background-color: #f5f5f4;">
                <th style="padding: 12px; border-bottom: 1px solid #e7e5e4;">Date</th>
                <th style="padding: 12px; border-bottom: 1px solid #e7e5e4;">Type</th>
                <th style="padding: 12px; border-bottom: 1px solid #e7e5e4;">Category</th>
                <th style="padding: 12px; border-bottom: 1px solid #e7e5e4;">Description</th>
                <th style="padding: 12px; border-bottom: 1px solid #e7e5e4;">Amount</th>
            </tr>
        </thead>
        <tbody>
            <% for(let t of transactions) { %>
                <tr style="border-bottom: 1px solid #f5f5f4;">
                    <td style="padding: 12px;"><%= t.date.toDateString() %></td>
                    <td style="padding: 12px; font-weight: bold; color: <%= t.type === 'income' ? '#16a34a' : '#dc2626' %>;"><%= t.type.toUpperCase() %></td>
                    <td style="padding: 12px;"><%= t.category %></td>
                    <td style="padding: 12px; color: #57534e;"><%= t.description %></td>
                    <td style="padding: 12px; font-weight: bold; color: <%= t.type === 'income' ? '#16a34a' : '#dc2626' %>;">
                        <%= t.type === 'income' ? '+' : '-' %>₦<%= t.amount %>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

</body>
</html>