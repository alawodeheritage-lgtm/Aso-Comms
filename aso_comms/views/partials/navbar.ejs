<nav
  style="display: flex; justify-content: space-between; align-items: center; padding: 16px 32px; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white; margin-bottom: 30px; border-radius: 0 0 12px 12px; box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.25); border-bottom: 1px solid rgba(255, 255, 255, 0.05);">

  <!-- Inside views/partials/navbar.ejs -->
  <a href="<%= (currentUser && (currentUser.role === 'manager' || currentUser.role === 'ceo' || currentUser.isStaff)) ? '/repairs' : '/complaints' %>"
    style="font-weight: 800; font-size: 18px; text-decoration: none; color: #0f172a;">
    AsoComms
  </a>

  <!-- USER PROFILE / AUTHENTICATION -->
  <div style="display: flex; align-items: center; gap: 16px;">
    <% if (!currentUser) { %>
      <a href="/login"
        style="text-decoration: none; color: #94a3b8; font-weight: 600; font-size: 14px; padding: 8px 16px; border-radius: 8px; transition: all 0.2s ease;"
        onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#94a3b8'">
        Login
      </a>
      <a href="/register"
        style="text-decoration: none; background: #3b82f6; color: white; padding: 9px 20px; border-radius: 8px; font-weight: 600; font-size: 14px; box-shadow: 0 2px 10px rgba(59, 130, 246, 0.3); transition: all 0.2s ease;"
        onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'">
        Register
      </a>
      <% } else { %>
        <!-- Active User Badge -->
        <div
          style="background: rgba(255, 255, 255, 0.05); padding: 8px 16px; border-radius: 30px; border: 1px solid rgba(255, 255, 255, 0.1); backdrop-filter: blur(8px); display: flex; align-items: center; gap: 10px;">
          <span style="position: relative; display: flex; height: 9px; width: 9px;">
            <span
              style="animate: ping; position: absolute; inline-size: 100%; block-size: 100%; border-radius: 9999px; background-color: #34d399; opacity: 0.75;"></span>
            <span
              style="position: relative; border-radius: 9999px; height: 9px; width: 9px; background-color: #10b981;"></span>
          </span>
          <span style="color: #94a3b8; font-size: 13px; font-weight: 500;">
            Logged in as: <strong style="color: #f8fafc; font-weight: 700; letter-spacing: -0.2px;">
              <%= currentUser.username %>
            </strong>
          </span>
        </div>
        <% } %>
  </div>

</nav>