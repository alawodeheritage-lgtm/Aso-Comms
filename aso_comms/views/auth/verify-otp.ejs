<%- include('../partials/flash') %>

<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh; font-family: 'Segoe UI', Roboto, sans-serif; background: #f1f5f9;">
    <div style="background: white; padding: 40px; border-radius: 12px; border: 1px solid #e2e8f0; width: 100%; max-width: 400px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
        
        <h2 style="margin: 0 0 10px 0; color: #0f172a; font-size: 22px; text-align: center;">🔒 Enter Verification Code</h2>
        <p style="text-align: center; color: #64748b; font-size: 14px; margin-bottom: 25px;">
            We've sent a 6-digit code to <strong><%= email %></strong>
        </p>

        <!-- Main Verification Form -->
        <form action="/verify-otp" method="POST" style="display: flex; flex-direction: column; gap: 20px;">
            <!-- Hidden fields to preserve state -->
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="purpose" value="<%= purpose %>">

            <div>
                <label style="display: block; font-weight: 600; margin-bottom: 8px; font-size: 13px; color: #334155;">6-Digit OTP Code</label>
                <input type="text" name="otp" required maxlength="6" placeholder="123456" 
                    style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 18px; text-align: center; letter-spacing: 6px; box-sizing: border-box;">
            </div>

            <button type="submit" style="background: #10b981; color: white; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 15px;">
                Verify Code ✓
            </button>
        </form>

        <!-- Resend OTP Form -->
        <form action="/resend-otp" method="POST" style="margin-top: 15px; text-align: center;">
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="purpose" value="<%= purpose %>">
            <button type="submit" style="background: none; border: none; color: #38bdf8; font-size: 13px; cursor: pointer; text-decoration: underline;">
                Didn't get the code? Resend OTP
            </button>
        </form>

    </div>
</div>